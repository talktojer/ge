# Firebase Authentication
# Get these from Firebase Console: https://console.firebase.google.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_JSON=path/to/service-account.json

# Database
# Use local postgres for dev, managed service for production
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/galactic_empire

# Redis
# Use local redis for dev, Upstash/managed for production
REDIS_URL=redis://localhost:6379/0

# JWT Session Tokens
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secret-key-here
JWT_EXPIRY_HOURS=1

# Environment
ENVIRONMENT=development

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# ge-sim Settings
SHIP_TICK_INTERVAL=6.0
PLANET_TICK_INTERVAL=55.0

# CORS (Unity client origins)
# In production, restrict to your app domains
ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=INFO
